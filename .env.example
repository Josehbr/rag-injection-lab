# Copie para .env e preencha com a sua chave.
# Qualquer provedor suportado pelo LiteLLM funciona; ajuste LITELLM_MODEL junto.

# Modelo de GERAÇÃO (responde as perguntas; precisa ser modelo de chat.
# Modelos de raciocínio também funcionam: o cliente ajusta os parâmetros sozinho)
LITELLM_MODEL=gpt-4o-mini

# Embeddings do retrieval vetorial:
#   api     — usa o modelo de embedding da API (exige que o projeto da chave
#             tenha acesso a ele; confira em GET /v1/models)
#   offline — embedding determinístico local, nenhum dado sai para API
EMBEDDINGS_SOURCE=api
EMBEDDING_MODEL=text-embedding-3-small

# Chave do provedor escolhido (nome varia: OPENAI_API_KEY, GROQ_API_KEY, ...)
OPENAI_API_KEY=
